# Environment variables template for Cybank

# MariaDB / MySQL Connection
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# Batas waktu koneksi DB dalam detik (default 5).
DB_CONNECT_TIMEOUT=5
# Set 1 untuk mencoba ulang koneksi ke localhost saat host utama gagal (mis. pakai
# salinan DB lokal). Biarkan 0 agar request cepat gagal ketika host tidak terjangkau.
DB_LOCALHOST_FALLBACK=0

# SSO & JWT Configuration
SSO_LOGIN_URL="https://cybeat.sibeux.my.id/api/auth/login"
SSO_REFRESH_URL="https://cybeat.sibeux.my.id/api/auth/refresh"
JWT_SECRET="your-jwt-secret-if-shared"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
